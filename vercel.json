{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api", "destination": "https://qsentinal.onrender.com/api" },
    { "source": "/api/(.*)", "destination": "https://qsentinal.onrender.com/api/$1" },
    { "source": "/docs", "destination": "https://qsentinal.onrender.com/docs" },
    { "source": "/docs/(.*)", "destination": "https://qsentinal.onrender.com/docs/$1" },
    { "source": "/openapi.json", "destination": "https://qsentinal.onrender.com/openapi.json" },
    { "source": "/redoc", "destination": "https://qsentinal.onrender.com/redoc" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
